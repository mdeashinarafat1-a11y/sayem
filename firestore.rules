rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Admin
    match /admins/{admin_id} {
      allow read: if isSignedIn();
      allow write: if false; // Admins are managed via console
    }

    // Books
    match /books/{book_id} {
      allow read: if isSignedIn();
      allow write: if false; // System managed or specifically allowed
    }

    // Students
    match /students/{student_id} {
      allow read: if isSignedIn();
      allow write: if false; // System managed
    }

    // Issue Books
    match /issue_books/{issue_id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
